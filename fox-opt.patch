--- fox-1.7.89/configure.ac.orig	2025-12-31 16:42:59.000000000 +0100
+++ fox-1.7.89/configure.ac	2026-01-29 22:29:05.506181018 +0100
@@ -65,9 +65,6 @@ AC_SUBST(LT_CURRENT)
